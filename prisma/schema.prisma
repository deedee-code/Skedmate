// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(uuid())
  phone            String      @unique
  name             String?
  timezone         String      @default("Africa/Lagos")
  createdAt        DateTime    @default(now())
  // Anti-ban daily quota tracking
  dailyMessageCount Int        @default(0)
  dailyQuotaDate   DateTime?
  schedules        Schedule[]
  broadcasts       Broadcast[]
  waSessions       WhatsAppSession[]
}

/// Stores Baileys multi-file auth state in the database.
/// Each row is one "file" that Baileys would normally write to disk.
model WhatsAppSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The auth key name, e.g. "creds", "app-state-sync-key-XXXXXX", "pre-key-1", etc.
  keyType   String
  /// The serialised JSON value for that key
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([userId, keyType])
  @@index([userId])
}

model Schedule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  recipient   String
  textContent String?
  mediaUrl    String?
  mediaType   String? // image | video | audio | document
  sendAt      DateTime
  recurrence  String? // null | daily | weekly | monthly | custom
  status      String   @default("pending") // pending | sent | failed | cancelled
  createdAt   DateTime @default(now())
}

model Broadcast {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  recipients  String[] // array of phone numbers
  textContent String?
  mediaUrl    String?
  mediaType   String?
  sendAt      DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model ConversationState {
  id        String   @id @default(uuid())
  phone     String   @unique
  state     String // e.g. AWAITING_NAME | MAIN_MENU | AWAITING_MESSAGE | AWAITING_RECIPIENT | AWAITING_TIME
  context   Json? // temporary data store during multi-step flows
  updatedAt DateTime @updatedAt
}
