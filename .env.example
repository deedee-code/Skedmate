PORT=3500
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/skedmate

# Redis
REDIS_URL=redis://localhost:6379

# Daily message quota per user (default: 50)
# Keeps personal accounts safe from Meta's anti-spam detection
DAILY_MESSAGE_QUOTA=50

# HuggingFace (AI fallback in main menu)
HUGGINGFACE_API_KEY=

# Cloudinary (format: cloudinary://api_key:api_secret@cloud_name)
CLOUDINARY_URL=
